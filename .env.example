# Скопируйте этот файл в .env и заполните значения

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Ваш Telegram ID (узнать: команда /id у бота) — для админ-команд /stats и /reload.
# Несколько ID через запятую.
ADMIN_IDS=

# Необязательно: своя папка с сетапами (по умолчанию ./setups рядом с ботом)
# SETUPS_DIR=C:\path\to\setups

# Необязательно: как часто (сек) бот перечитывает папку сетапов (по умолчанию 15)
# LIBRARY_CACHE_TTL=15
